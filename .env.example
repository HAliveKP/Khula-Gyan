# Copy this file to .env and fill values locally after choosing a provider.
# Never commit .env or paste a real key into an issue, prompt, or source file.
LLM_PROVIDER=choose-with-team
LLM_MODEL=choose-with-team
LLM_API_KEY=
# Optional. Use only if the selected provider requires a custom endpoint.
LLM_BASE_URL=
# Provisional per-process spend cap. Confirm this limit with the project owner.
MAX_API_SPEND_USD=1.00
# Configure both rates from the selected provider's current published pricing.
# Values are USD per 1 million tokens; leave blank to block paid API requests.
LLM_INPUT_COST_PER_1M_USD=
LLM_OUTPUT_COST_PER_1M_USD=
# Maximum output reserved and requested per API call.
MAX_API_OUTPUT_TOKENS=1024

