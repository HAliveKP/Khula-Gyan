# Copy this file to .env and fill values locally.
# Never commit .env or paste a real key into an issue, prompt, or source file.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=choose-with-team
# One key, or several separated by commas. Several = each call uses the next key in turn;
# a rate-limited or out-of-credit key rests for a minute, an invalid key is skipped.
LLM_API_KEYS=
# Optional: "failover" = always start with the first key, use the others only as backups.
# LLM_KEY_STRATEGY=round_robin
# Set LLM_PROVIDER=fake to run everything without any key (answers are nonsense on purpose).
